# =============================================================================
#  AGATHA SOUZA STUDIO - configuracao local
#  O start.bat cria o arquivo ".env" a partir deste e preenche o que estiver vazio.
#  NUNCA compartilhe nem envie o ".env" (ele contem senha e chave).
# =============================================================================

# Ambiente: development (uso no seu computador) | production (servidor publico)
APP_ENV=development

# Chave que assina o login (cookie de sessao). Tem de ser SEMPRE a mesma neste computador:
# se mudar, todo mundo e deslogado. O start.bat gera uma UNICA vez e grava aqui.
# Para gerar manualmente:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco de dados. Padrao: instance/studio.db (nao precisa mudar).
# DATABASE_URL=

# LOGIN DE DESENVOLVIMENTO. Na primeira execução, uma senha aleatória será gerada
# e exibida no terminal. Para definir outra, preencha DEV_ADMIN_PASSWORD e rode
#       start.bat login          (aplica o e-mail e a senha deste arquivo, mesmo num banco que ja existia)
# Mínimo de 10 caracteres. Em branco = o sistema gera uma e grava aqui.
DEV_ADMIN_NAME=Agatha Souza
DEV_ADMIN_EMAIL=agatha@example.com
DEV_ADMIN_PASSWORD=
